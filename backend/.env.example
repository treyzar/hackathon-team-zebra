# Copy to .env and fill in. .env is read by docker compose (interpolation and
# env_file) and by the app itself (pydantic-settings) when run from backend/.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Postgres ---------------------------------------------------------------
# The password is applied only when the volume is created; to change it later,
# ALTER USER in the database or recreate the pgdata volume.
POSTGRES_USER=mda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Auth -------------------------------------------------------------------
JWT_KEY=change-me-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Dev only; docker-compose.prod.yml sets it to https://SITE_DOMAIN.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- File storage (S3; SeaweedFS in docker compose) ------------------------
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=zebra
# Address the browser uses for presigned URLs. Dev only; production uses
# https://S3_DOMAIN.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Judge0 -----------------------------------------------------------------
# Judge0 runs on the server; developers' workers connect to it as well.
# Production overrides the URL with the internal address.
JUDGE0_URL=https://judge0.cifrovye-zodchie.ru
# Same value as in the server's .env: Judge0 rejects requests without it.
JUDGE0_AUTH_TOKEN=change-me

# --- Production only (docker-compose.prod.yml) ------------------------------
SITE_DOMAIN=cifrovye-zodchie.ru
S3_DOMAIN=files.cifrovye-zodchie.ru
JUDGE0_DOMAIN=judge0.cifrovye-zodchie.ru
# Let's Encrypt account e-mail: expiry warnings and problems are sent here.
ACME_EMAIL=change-me@example.com
# Token for Judge0 admin endpoints (listing all submissions etc.).
JUDGE0_ADMIN_TOKEN=change-me
JUDGE0_DB_PASSWORD=change-me
JUDGE0_REDIS_PASSWORD=change-me

# --- Optional: host ports (dev) ----------------------------------------------
# POSTGRES_PORT=5432
# API_PORT=8000
# S3_PORT=9000
# FRONTEND_PORT=5173
# VITE_API_URL=http://localhost:8000/api
