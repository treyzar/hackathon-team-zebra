{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cifrovye-zodchie.ru/schemas/course-import-v2.json",
  "title": "CourseImport",
  "description": "Тело файла для POST /api/admin/courses/import (multipart/form-data, поле file). Тот же формат, что отдаёт GET /api/admin/courses/{id}/export.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "course"],
  "properties": {
    "schema_version": { "const": 2, "description": "Версия формата; сейчас всегда 2." },
    "course": { "$ref": "#/$defs/course" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "richText": {
      "type": "object",
      "description": "Документ TipTap/ProseMirror. Содержимое узлов (attrs, marks) не проверяется.",
      "required": ["type"],
      "properties": {
        "type": { "const": "doc" },
        "content": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "showAnswer": {
      "enum": ["never", "after_wrong", "after_attempts_exhausted", "after_solved"]
    },
    "maxAttempts": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "skills": {
      "type": "array",
      "description": "Навыки модуля для карты навыков учеников.",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 },
      "default": []
    },
    "checklist": {
      "type": "array",
      "description": "Чек-лист ручной проверки: сумма points равна max_score; только при проверке куратором.",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "text", "points"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "points": { "type": "number", "minimum": 0, "maximum": 1000 },
          "hint": { "type": ["string", "null"], "maxLength": 2000 }
        }
      },
      "default": []
    },
    "course": {
      "type": "object",
      "required": ["slug", "title", "modules"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "$ref": "#/$defs/richText" },
        "step_access": { "enum": ["all", "sequential"], "default": "all" },
        "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
      }
    },
    "module": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "skills": { "$ref": "#/$defs/skills" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "required": ["payload"],
      "additionalProperties": false,
      "properties": {
        "is_hidden": { "type": "boolean", "default": false },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/theoryPayload" },
        { "$ref": "#/$defs/singleChoicePayload" },
        { "$ref": "#/$defs/multipleChoicePayload" },
        { "$ref": "#/$defs/freeTextPayload" },
        { "$ref": "#/$defs/programmingPayload" },
        { "$ref": "#/$defs/numberPayload" },
        { "$ref": "#/$defs/shortTextPayload" }
      ]
    },
    "theoryPayload": {
      "type": "object",
      "required": ["type", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "theory" },
        "max_score": { "const": 0 },
        "content": {
          "type": "object",
          "required": ["body"],
          "additionalProperties": false,
          "properties": { "body": { "$ref": "#/$defs/richText" } }
        },
        "answer_key": { "type": "object", "additionalProperties": false },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "grading": { "const": "none" } }
        }
      }
    },
    "choiceContent": {
      "type": "object",
      "required": ["question", "options"],
      "additionalProperties": false,
      "properties": {
        "question": { "$ref": "#/$defs/richText" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    "singleChoicePayload": {
      "type": "object",
      "required": ["type", "max_score", "content", "answer_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "single_choice" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": { "$ref": "#/$defs/choiceContent" },
        "answer_key": {
          "type": "object",
          "required": ["correct"],
          "additionalProperties": false,
          "properties": { "correct": { "$ref": "#/$defs/uuid" } }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": { "const": "auto" },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" }
          }
        }
      }
    },
    "multipleChoicePayload": {
      "type": "object",
      "required": ["type", "max_score", "content", "answer_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "multiple_choice" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": { "$ref": "#/$defs/choiceContent" },
        "answer_key": {
          "type": "object",
          "required": ["correct"],
          "additionalProperties": false,
          "properties": {
            "correct": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/uuid" }
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": { "const": "auto" },
            "scoring": { "enum": ["all_or_nothing", "partial"], "default": "all_or_nothing" },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" }
          }
        }
      }
    },
    "freeTextPayload": {
      "type": "object",
      "required": ["type", "max_score", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "free_text" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": {
          "type": "object",
          "required": ["question"],
          "additionalProperties": false,
          "properties": {
            "question": { "$ref": "#/$defs/richText" },
            "require_text": { "type": "boolean", "default": false },
            "min_files": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0 },
            "max_files": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0 },
            "allowed_mime": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            }
          }
        },
        "answer_key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "oneOf": [{ "$ref": "#/$defs/richText" }, { "type": "null" }]
            },
            "criteria": {
              "oneOf": [{ "type": "string", "maxLength": 10000 }, { "type": "null" }]
            },
            "files": {
              "type": "array",
              "items": { "type": "integer" },
              "default": []
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": { "const": "manual" },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" },
            "checklist": { "$ref": "#/$defs/checklist" }
          }
        }
      }
    },
    "programmingPayload": {
      "type": "object",
      "required": ["type", "max_score", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "programming" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": {
          "type": "object",
          "required": ["statement"],
          "additionalProperties": false,
          "properties": {
            "statement": { "$ref": "#/$defs/richText" },
            "languages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": ["python3", "javascript", "cpp", "csharp", "go", "pascal"]
              },
              "default": ["python3"]
            },
            "time_limit_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 15000,
              "default": 2000
            },
            "memory_limit_mb": {
              "type": "integer",
              "minimum": 16,
              "maximum": 512,
              "default": 256
            },
            "template": { "type": "string", "maxLength": 65536, "default": "" },
            "samples": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["input", "output"],
                "additionalProperties": false,
                "properties": {
                  "input": { "type": "string", "maxLength": 1000000, "default": "" },
                  "output": { "type": "string", "maxLength": 1000000, "default": "" }
                }
              }
            }
          }
        },
        "answer_key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "test_groups": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": ["name", "tests"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "points": { "type": "integer", "minimum": 0, "default": 0 },
                  "tests": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "input": { "type": "string", "maxLength": 1000000, "default": "" },
                        "output": { "type": "string", "maxLength": 1000000, "default": "" },
                        "input_file": {
                          "oneOf": [{ "type": "integer" }, { "type": "null" }],
                          "default": null
                        },
                        "output_file": {
                          "oneOf": [{ "type": "integer" }, { "type": "null" }],
                          "default": null
                        }
                      }
                    }
                  }
                }
              }
            },
            "reference_solution": {
              "oneOf": [{ "type": "string", "maxLength": 65536 }, { "type": "null" }]
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": {
              "enum": ["tests", "tests_and_review", "manual"],
              "default": "tests"
            },
            "scoring": {
              "enum": ["all_or_nothing", "per_group"],
              "default": "all_or_nothing"
            },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" },
            "checklist": { "$ref": "#/$defs/checklist" }
          }
        }
      }
    },
    "numberPayload": {
      "type": "object",
      "required": ["type", "max_score", "content", "answer_key"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "number" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": {
          "type": "object",
          "required": ["question"],
          "additionalProperties": false,
          "properties": {
            "question": { "$ref": "#/$defs/richText" },
            "kind": { "enum": ["integer", "decimal"], "default": "integer" },
            "precision": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 }
          }
        },
        "answer_key": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": { "const": "auto" },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" }
          }
        }
      }
    },
    "shortTextPayload": {
      "type": "object",
      "required": ["type", "max_score", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "short_text" },
        "max_score": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "content": {
          "type": "object",
          "required": ["question"],
          "additionalProperties": false,
          "properties": { "question": { "$ref": "#/$defs/richText" } }
        },
        "answer_key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepted": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "maxLength": 500 },
              "default": []
            },
            "case_sensitive": { "type": "boolean", "default": false }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grading": { "enum": ["auto", "manual"], "default": "auto" },
            "max_attempts": { "$ref": "#/$defs/maxAttempts" },
            "show_answer": { "$ref": "#/$defs/showAnswer" },
            "checklist": { "$ref": "#/$defs/checklist" }
          }
        }
      }
    }
  }
}